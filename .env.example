# ================================================================
# JAGRITI CHOWK GANESH MANDAL 2026 - PRODUCTION ENVIRONMENT CONFIG
# ================================================================

# Flask Security & Environment
SECRET_KEY=generate-a-strong-random-secret-key-for-production
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000
# Leave false/unset after the first intentional production initialization.
ALLOW_DESTRUCTIVE_SEED=false

# ================================================================
# REMOTE / CLOUD MYSQL DATABASE CONFIGURATION
# ================================================================
# Option A: Full Connection URI (used by Railway, Render, PlanetScale, Aiven, Cleardb, etc.)
# Format: mysql://username:password@hostname:port/database_name
DATABASE_URL=mysql://root:your_secure_password@mysql-production.host.com:3306/ganesh_mandal_db

# Option B: Individual MySQL Connection Parameters
DB_HOST=mysql-production.host.com
DB_PORT=3306
DB_NAME=ganesh_mandal_db
DB_USER=mandal_admin
DB_PASSWORD=your_secure_password

# For production SQLite instead of MySQL, set this to a persistent volume path.
# Do not use the application checkout or an ephemeral container path.
# DATABASE_PATH=/var/data/ganesh_mandal_2026.db

# ================================================================
# PERSISTENT STORAGE CONFIGURATION FOR BILLS & RECEIPTS
# ================================================================
# For persistent disk mounts on cloud platforms (e.g. Render Disk, Railway Volume, Docker Volume)
# Set absolute mount path here:
UPLOAD_FOLDER=/app/uploads

# ================================================================
# MANDAL DETAILS (Bilingual)
# ================================================================
MANDAL_NAME_MR=जागृती चौक गणेशोत्सव मंडळ
MANDAL_NAME_EN=Jagriti Chowk Ganeshotsav Mandal
FESTIVAL_TITLE_MR=गणेशोत्सव २०२६ हिशोब व व्यवस्थापन प्रणाली
FESTIVAL_TITLE_EN=Ganeshotsav 2026 Accounting & Management System
